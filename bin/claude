#!/usr/bin/env bash
# scott — https://github.com/turinglabsorg/scott
#
# Runs Claude Code in Docker as if it were native:
#   - your home is bind-mounted at the SAME path and used as HOME, so Claude
#     sees your real ~/.claude (CLAUDE.md, skills, settings, memory, history),
#     ~/.claude.json and everything they reference
#   - the working directory is the folder you launched `claude` from; if it is
#     outside your home, that folder (or the root of its git repo) is mounted
#     at the same path too
#   - every edit lands straight on the host filesystem: the container keeps no
#     state of its own and is removed on exit
#   - it runs as your uid/gid, so files it creates are owned by you
set -euo pipefail

PERSONAL="${CLAUDE_DOCKER_PERSONAL:-$HOME/.claude-docker}"
# shellcheck disable=SC1091
[ -f "$PERSONAL/env" ] && . "$PERSONAL/env"

IMAGE="${CLAUDE_DOCKER_IMAGE:-scott:latest}"
DOCKER="$(command -v docker 2>/dev/null || echo /usr/local/bin/docker)"

home="$(cd "$HOME" && pwd -P)"
workdir="$(pwd -P)"

args=(run --rm --init -i --shm-size=1g
      --user "$(id -u):$(id -g)"
      -v "$home:$home" -e "HOME=$home"
      -w "$workdir"
      -e "USER=$(id -un)" -e TERM -e COLORTERM)

case "$workdir/" in
    "$home"/*) ;;
    *)
        mount="$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null || true)"
        [ -n "$mount" ] || mount="$workdir"
        args+=(-v "$mount:$mount")
        ;;
esac

# Cloud identity roots never reach the container: each one is covered by an
# empty, read-only tmpfs, so the home is mounted without them. The Google Cloud
# config dirs (~/.config/gcloud, and any ~/.config/gcloud-* profile roots) are
# masked by default; CLAUDE_DOCKER_MASK adds more paths, space-separated.
masks=()
for d in "$home"/.config/gcloud "$home"/.config/gcloud-*; do
    [ -e "$d" ] && masks+=("$d")
done
for d in ${CLAUDE_DOCKER_MASK:-}; do
    case "$d" in /*) ;; *) d="$home/$d" ;; esac
    masks+=("$d")
done
for d in ${masks[@]+"${masks[@]}"}; do
    args+=(--mount "type=tmpfs,destination=$d,tmpfs-size=1m,tmpfs-mode=0555")
done

# macOS symlinks /tmp, /var and /etc into /private: also expose the launch
# folder at the path you typed, so arguments like /tmp/x resolve inside too
logical="${PWD:-$workdir}"
[ "$logical" != "$workdir" ] && args+=(-v "$workdir:$logical")

# Opt-in: the host Docker engine, so Claude can run docker and docker compose.
# Docker Desktop exposes the socket as root:root 660 inside containers.
# DOCKER_HOST wins over the docker context in the mounted ~/.docker, which on
# macOS points at a host socket that cannot cross into the container.
if [ "${CLAUDE_DOCKER_SOCKET:-0}" = 1 ]; then
    sock_gid=0
    [ "$(uname -s)" = Darwin ] || sock_gid="$(stat -c %g /var/run/docker.sock)"
    args+=(-v /var/run/docker.sock:/var/run/docker.sock --group-add "$sock_gid"
           -e DOCKER_HOST=unix:///var/run/docker.sock)
fi

# Claude Code settings from the environment pass through by name: docker reads
# the values from this process, so keys never appear on a command line.
# A base URL on the host loopback (e.g. set by `ollama launch claude`) is
# rewritten to host.docker.internal, which reaches the host from inside.
base_url=""
if [[ "${ANTHROPIC_BASE_URL:-}" =~ ^(https?://)(localhost|127\.0\.0\.1)([:/].*)?$ ]]; then
    base_url="${BASH_REMATCH[1]}host.docker.internal${BASH_REMATCH[3]}"
    args+=(-e "ANTHROPIC_BASE_URL=$base_url")
fi
while IFS= read -r name; do
    [ -n "$base_url" ] && [ "$name" = ANTHROPIC_BASE_URL ] && continue
    args+=(-e "$name")
done < <(compgen -e | grep -E '^(ANTHROPIC_|CLAUDE_CODE_|DISABLE_|BW_|BITWARDENCLI_|HUSH_|API_TIMEOUT_MS$|MAX_THINKING_TOKENS$|MCP_(TOOL_)?TIMEOUT$|BASH_(DEFAULT|MAX)_TIMEOUT_MS$|(HTTPS?|NO)_PROXY$|(https?|no)_proxy$)' || true)
for name in ${CLAUDE_DOCKER_ENV:-}; do
    args+=(-e "$name")
done
[ "$(uname -s)" = Darwin ] || args+=(--add-host=host.docker.internal:host-gateway)

# The Bitwarden CLI keeps its data per OS: ~/Library/Application Support on
# macOS, ~/.config on Linux. Point the Linux one at the macOS data dir, so an
# existing login (e.g. an agent's own account used by hush) works inside too.
bw_mac="$home/Library/Application Support/Bitwarden CLI"
if [ -z "${BITWARDENCLI_APPDATA_DIR:-}" ] && [ -d "$bw_mac" ]; then
    args+=(-e "BITWARDENCLI_APPDATA_DIR=$bw_mac")
fi

[ -t 0 ] && [ -t 1 ] && args+=(-t)

# Pasting images: Claude Code on Linux reads the clipboard through xclip, and
# no container can reach the Mac clipboard. For an interactive session on macOS
# the launcher starts a small bridge on the host loopback that hands over the
# clipboard image (never text) to requests carrying a random token, and exits
# with the session; the image's xclip asks it. CLAUDE_DOCKER_CLIPBOARD=0 skips it.
if [ "$(uname -s)" = Darwin ] && [ -t 0 ] && [ -t 1 ] && [ "${CLAUDE_DOCKER_CLIPBOARD:-1}" = 1 ]; then
    read -r -d '' bridge <<'PERL' || true
use strict;
use warnings;
use File::Temp qw(tempdir);
use IO::Select;
use IO::Socket::INET;
use POSIX qw(setsid);

my $owner = shift;
my $server = IO::Socket::INET->new(LocalAddr => "127.0.0.1", LocalPort => 0,
                                   Listen => 5, ReuseAddr => 1) or exit 1;
open my $random, "<:raw", "/dev/urandom" or exit 1;
read $random, my $bytes, 16;
my $token = unpack "H*", $bytes;
defined(my $pid = fork) or exit 1;
if ($pid) { print $server->sockport, "/$token\n"; exit 0; }
setsid();
open STDIN, "<", "/dev/null";
open STDOUT, ">", "/dev/null";
open STDERR, ">", "/dev/null";

my $png = tempdir(CLEANUP => 1) . "/clipboard.png";
my $class = "\xc2\xabclass PNGf\xc2\xbb";
sub image {
    unlink $png;
    system "osascript", "-e", "set png_data to (the clipboard as $class)",
        "-e", "set fp to open for access POSIX file \"$png\" with write permission",
        "-e", "write png_data to fp", "-e", "close access fp";
    open my $in, "<:raw", $png or return "";
    local $/;
    my $data = <$in> // "";
    unlink $png;
    return $data;
}

my $select = IO::Select->new($server);
while (kill 0, $owner) {
    $select->can_read(2) or next;
    my $client = $server->accept or next;
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm 10;
        my ($path) = (<$client> // "") =~ m{^GET /(\S+) };
        while (my $line = <$client>) { last if $line =~ /^\r?\n$/ }
        my $data = "";
        if (defined $path && ($path eq "$token/png" || $path eq "$token/targets")) {
            $data = image();
            $data = "image/png\n" if length $data && $path eq "$token/targets";
        }
        print {$client} length $data
            ? "HTTP/1.0 200 OK\r\nContent-Length: " . length($data) . "\r\n\r\n" . $data
            : "HTTP/1.0 404 Not Found\r\nContent-Length: 0\r\n\r\n";
        alarm 0;
    };
    close $client;
}
PERL
    clipboard="$(perl -e "$bridge" "$$" 2>/dev/null || true)"
    if [ -n "$clipboard" ]; then
        export SCOTT_CLIPBOARD="http://host.docker.internal:$clipboard"
        args+=(-e SCOTT_CLIPBOARD)
    fi
fi

for extra in ${CLAUDE_DOCKER_MOUNTS:-}; do
    args+=(-v "$extra:$extra")
done

[ -n "${CLAUDE_DOCKER_ENTRYPOINT:-}" ] && args+=(--entrypoint "$CLAUDE_DOCKER_ENTRYPOINT")

exec "$DOCKER" "${args[@]}" "$IMAGE" "$@"
